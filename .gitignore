# =============================================================================
# IoTGuard - Comprehensive .gitignore
# =============================================================================

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# Package Manager Logs & Cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*

# Python Caches & Bytecode
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Environment Variables, Secrets & Sensitive Credentials
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
id_rsa
id_ed25519
secrets.*
credentials.*
*.secret

# Databases & Cache Stores
*.sqlite
*.sqlite3
*.db
*.bak

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Configurations
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json

# Temporary & Log Files
*.log
logs/
temp/
tmp/

# Legacy Scaffold & Handover Files
UPLOAD_BUNDLE_NOTE.txt
frontend/public/manus-routes.json
