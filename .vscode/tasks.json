{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run IoTGuard (Full Stack)",
      "type": "shell",
      "command": "python -m uvicorn backend.main:app --host 0.0.0.0 --port 3000",
      "isBackground": true,
      "presentation": {
        "reveal": "always"
      },
      "problemMatcher": {
        "owner": "python",
        "pattern": {
          "regexp": "^(.*):(\\d+):\\s+(.*)$",
          "file": 1,
          "location": 2,
          "message": 3
        }
      }
    }
  ]
}
